{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "x-api-key": "test-key",
    "anthropic-version": "2023-06-01",
    "content-type": "application/json"
  },
  "json": {
    "model": "claude-opus-5",
    "max_tokens": 16000,
    "tools": [
      {
        "name": "get_weather",
        "description": "Current weather in a city.",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ]
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "What is the weather in Paris?"
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "tool_use",
            "id": "toolu_h1",
            "name": "get_weather",
            "input": {
              "city": "Paris"
            }
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "toolu_h1",
            "content": "18°C and sunny"
          },
          {
            "type": "text",
            "text": "Here is the weather."
          }
        ]
      }
    ]
  }
}
